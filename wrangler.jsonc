{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labdecode",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
